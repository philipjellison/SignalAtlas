[Unit]
Description=Geochron HamSCI Display
After=network.target
Wants=network.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=geochron-display
WorkingDirectory=/opt/geochron-display
ExecStart=/opt/geochron-display/bin/geochron-display
Environment=GEOCHRON_BIND=0.0.0.0:3000
Environment=GEOCHRON_CONFIG=/var/lib/geochron-display/config.json
Environment=GEOCHRON_WSPR_CACHE=/var/lib/geochron-display/wspr-cache.json
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes

[Install]
WantedBy=multi-user.target
