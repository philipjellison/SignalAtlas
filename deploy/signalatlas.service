[Unit]
Description=SignalAtlas Display
After=network.target
Wants=network.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=signalatlas
WorkingDirectory=/opt/signalatlas
ExecStart=/opt/signalatlas/bin/signalatlas
Environment=SIGNALATLAS_BIND=0.0.0.0:3000
Environment=SIGNALATLAS_CONFIG=/var/lib/signalatlas/config.json
Environment=SIGNALATLAS_WSPR_CACHE=/var/lib/signalatlas/wspr-cache.json
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes

[Install]
WantedBy=multi-user.target
